# Copy outside the repository to ~/.config/hermes-gateway/hermes-01.env (or 03).
# Set real credentials privately. Never commit the populated file.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=replace-locally
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=replace-locally
# Retain legacy dashboard only while rollback is required.
HERMES_DASHBOARD=true
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9199
# Model-provider credentials and other instance-specific settings belong here too.
